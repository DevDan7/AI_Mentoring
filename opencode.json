{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "agent": {
    "plan": {
      "prompt": "{file:./.opencode/prompts/plan.txt}"
    },
    "git": {
      "description": "Generate git commands for committing and pushing changes"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "terraform plan *": "deny",
      "terraform apply *": "deny"
    },
    "edit": "allow"
  }
}